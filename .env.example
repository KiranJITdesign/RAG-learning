# Copy to .env and edit. Nothing here is required to run the project:
# with no .env at all you get the hashing embedder and extractive answers.

# ---------- embeddings ----------
# hashing | sentence-transformers | openai
EMBED_BACKEND=hashing
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- the language model ----------
# extractive | ollama | openai | gemini | anthropic
LLM_PROVIDER=extractive

# Local and free (recommended first step):
#   install ollama, then:  ollama pull llama3.2
#   and:                   ollama serve
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Hosted options, pick one:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
